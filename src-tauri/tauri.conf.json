{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "RF CALC",
  "version": "1.0.0-beta.1",
  "identifier": "ru.irt.dncalc.v3",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://127.0.0.1:1422",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "RF CALC · Антенны ИРТ",
        "width": 1320,
        "height": 880,
        "minWidth": 1024,
        "minHeight": 700,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ]
  }
}
